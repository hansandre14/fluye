---
/**
 * DeleteButton.astro
 * Componente de acción destructiva "ELIMINAR" con Redundancia Sensorial (WCAG 2.1 AAA).
 * Sincroniza retroalimentación Visual (microinteracción física + pulso),
 * Auditiva (Earcon sintético Web Audio API < 280 ms con control de silencio WCAG 1.4.2)
 * y Háptica/Táctil (HTML5 Vibration API [50, 30, 50] ms).
 */
interface Props {
  movementId?: string;
  movementName?: string;
  label?: string;
  variant?: 'row' | 'confirm';
  type?: 'button' | 'submit';
  dialogId?: string;
  disabled?: boolean;
}

const {
  movementId = '',
  movementName = 'elemento',
  label = 'Eliminar',
  variant = 'row',
  type = 'button',
  dialogId = 'delete-dialog',
  disabled = false,
} = Astro.props;

const ariaLabel = movementName && variant === 'row'
  ? `Eliminar ${movementName}`
  : `${label} (acción destructiva con 10 segundos para deshacer)`;
---

<span class="sensory-delete-wrapper">
  <button
    type={type}
    class:list={[
      'delete-action sensory-delete-btn',
      variant === 'confirm' ? 'primary-button danger-button sensory-confirm' : 'sensory-row',
    ]}
    aria-label={ariaLabel}
    aria-haspopup={variant === 'row' ? 'dialog' : undefined}
    data-sensory-delete
    data-variant={variant}
    data-open-dialog={variant === 'row' ? dialogId : undefined}
    data-movement-id={movementId || undefined}
    data-movement-name={movementName || undefined}
    disabled={disabled}
  >
    <svg
      class="sensory-delete-icon"
      viewBox="0 0 20 20"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3 5h14M8 5V3.5A1.5 1.5 0 0 1 9.5 2h1A1.5 1.5 0 0 1 12 3.5V5m2.5 0-.8 11.2a1.5 1.5 0 0 1-1.5 1.3H7.8a1.5 1.5 0 0 1-1.5-1.3L5.5 5" />
    </svg>
    <span class="sensory-delete-text">{label}</span>
    <span class="sensory-pulse-ring" aria-hidden="true"></span>
  </button>
  <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-sensory-status></span>
</span>

<script>
  /**
   * Controlador de Redundancia Sensorial (Visual + Auditiva + Háptica en estricta sincronía)
   */
  let sharedAudioCtx = null;

  function isAudioMuted() {
    if (typeof window === 'undefined') return true;
    const explicitMute = localStorage.getItem('fluye_mute_audio') === '1'
      || document.documentElement.dataset.audioMuted === 'true';
    const prefersReducedTransparencyOrQuiet = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches
      && localStorage.getItem('fluye_mute_audio') !== '0';
    return explicitMute || prefersReducedTransparencyOrQuiet;
  }

  /**
   * Canal Auditivo (WCAG 1.4.2): Earcon sintético (< 260 ms) vía Web Audio API sin archivos externos.
   * Genera un acorde bitonal descendente corto (520 Hz -> 340 Hz) que denota precaución/eliminación.
   */
  function playDeleteEarcon(variant = 'row') {
    if (isAudioMuted()) return;
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) return;

    try {
      if (!sharedAudioCtx) sharedAudioCtx = new AudioCtx();
      if (sharedAudioCtx.state === 'suspended') {
        sharedAudioCtx.resume().catch(() => {});
      }

      const now = sharedAudioCtx.currentTime;
      const osc = sharedAudioCtx.createOscillator();
      const gain = sharedAudioCtx.createGain();

      osc.type = variant === 'confirm' ? 'triangle' : 'sine';
      const startFreq = variant === 'confirm' ? 480 : 540;
      const endFreq = variant === 'confirm' ? 260 : 360;
      const duration = 0.22; // 220 ms (< 500 ms requerido)

      osc.frequency.setValueAtTime(startFreq, now);
      osc.frequency.exponentialRampToValueAtTime(endFreq, now + duration);

      gain.gain.setValueAtTime(0.001, now);
      gain.gain.linearRampToValueAtTime(0.14, now + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

      osc.connect(gain);
      gain.connect(sharedAudioCtx.destination);

      osc.start(now);
      osc.stop(now + duration + 0.01);
    } catch {
      // Fallo silencioso seguro si el navegador bloquea autoplay de Web Audio
    }
  }

  /**
   * Canal Háptico / Táctil: HTML5 Vibration API con patrón distintivo [50, 30, 50] ms.
   */
  function triggerHapticFeedback() {
    try {
      if (typeof navigator !== 'undefined' && typeof navigator.vibrate === 'function') {
        navigator.vibrate([50, 30, 50]);
      }
    } catch {
      // Dispositivos de escritorio o iOS sin soporte ignoran de forma segura
    }
  }

  /**
   * Canal Visual + Anuncio ARIA: Activa la compresión física y anillo de onda de forma sincrónica.
   */
  function triggerVisualAndAriaFeedback(button) {
    button.setAttribute('data-pressed', 'true');
    window.setTimeout(() => {
      button.removeAttribute('data-pressed');
    }, 280);

    const wrapper = button.closest('.sensory-delete-wrapper');
    const liveRegion = wrapper?.querySelector('[data-sensory-status]');
    if (liveRegion) {
      const targetName = button.dataset.movementName || 'elemento';
      liveRegion.textContent = button.dataset.variant === 'confirm'
        ? `Confirmando eliminación de ${targetName}. Tienes 10 segundos para deshacer.`
        : `Diálogo de confirmación abierto para eliminar ${targetName}.`;
    }
  }

  /**
   * Sincronía Multisensorial Estricta: Dispara los 3 canales en el mismo ciclo de evento.
   */
  function handleSensoryDelete(event) {
    const button = event.currentTarget;
    if (!(button instanceof HTMLButtonElement) || button.disabled) return;

    const variant = button.dataset.variant || 'row';

    // Disparo sincrónico de los 3 canales sensoriales (Visual + Auditivo + Háptico)
    triggerVisualAndAriaFeedback(button);
    playDeleteEarcon(variant);
    triggerHapticFeedback();
  }

  function bindSensoryDeleteButtons() {
    for (const button of document.querySelectorAll('[data-sensory-delete]')) {
      if (button.dataset.sensoryBound === 'true') continue;
      button.dataset.sensoryBound = 'true';
      button.addEventListener('click', handleSensoryDelete);
      button.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          button.setAttribute('data-pressed', 'true');
        }
      });
      button.addEventListener('keyup', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          button.removeAttribute('data-pressed');
        }
      });
    }
  }

  bindSensoryDeleteButtons();
  document.addEventListener('astro:page-load', bindSensoryDeleteButtons);
</script>

<style>
  .sensory-delete-wrapper {
    display: inline-flex;
    position: relative;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Contraste WCAG 2.1 AAA (>= 7:1): #881313 sobre #fff2f2 (Ratio 8.4:1 en modo claro) */
  .sensory-delete-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 6px 13px;
    border-radius: 16px;
    font-weight: 800;
    font-size: 14px;
    line-height: 1.2;
    user-select: none;
    transform: translateZ(0) scale(1);
    transition:
      transform 120ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease,
      color 150ms ease;
  }

  .sensory-row {
    background-color: #fff5f5;
    border: 1.5px solid #991b1b;
    color: #7f1d1d;
    box-shadow: 0 1px 2px rgba(127, 29, 29, 0.08);
  }

  .sensory-row:hover:not(:disabled) {
    background-color: #fee2e2;
    border-color: #7f1d1d;
    color: #450a0a;
    transform: translateY(-1px) scale(1.01);
    box-shadow: 0 4px 10px rgba(153, 27, 27, 0.16);
    text-decoration: none;
  }

  .sensory-confirm {
    min-height: 46px;
    padding: 10px 18px;
    background-color: #991b1b;
    border: 2px solid #7f1d1d;
    color: #ffffff;
    box-shadow: 0 3px 10px rgba(153, 27, 27, 0.25);
  }

  .sensory-confirm:hover:not(:disabled) {
    background-color: #7f1d1d;
    border-color: #450a0a;
    transform: translateY(-1px) scale(1.01);
    box-shadow: 0 6px 14px rgba(127, 29, 29, 0.32);
  }

  /* Focus Visible de alto contraste (WCAG 2.4.7 / 2.4.11 AAA) */
  .sensory-delete-btn:focus-visible {
    outline: 3px solid #dc2626;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px rgba(220, 38, 38, 0.22);
  }

  /* Sensación física de presión (:active y [data-pressed="true"]) */
  .sensory-delete-btn:active:not(:disabled),
  .sensory-delete-btn[data-pressed="true"]:not(:disabled) {
    transform: translateY(1px) scale(0.95);
    box-shadow: inset 0 2px 5px rgba(69, 10, 10, 0.25);
  }

  .sensory-delete-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .sensory-delete-icon {
    flex-shrink: 0;
    transition: transform 150ms ease;
  }

  .sensory-delete-btn:hover:not(:disabled) .sensory-delete-icon {
    transform: rotate(-6deg) scale(1.06);
  }

  /* Onda visual sincrónica al disparar la acción */
  .sensory-pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle, rgba(220, 38, 38, 0.28) 0%, transparent 70%);
  }

  .sensory-delete-btn[data-pressed="true"] .sensory-pulse-ring {
    animation: sensoryRipple 260ms ease-out forwards;
  }

  @keyframes sensoryRipple {
    0% {
      opacity: 1;
      transform: scale(0.75);
    }
    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  /* Soporte para Modo Oscuro (WCAG AAA >= 7:1 sobre fondo oscuro) */
  :global(html[data-theme="dark"]) .sensory-row {
    background-color: #2c1215;
    border-color: #f87171;
    color: #fecaca;
  }

  :global(html[data-theme="dark"]) .sensory-row:hover:not(:disabled) {
    background-color: #451a1f;
    border-color: #fca5a5;
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .sensory-confirm {
    background-color: #dc2626;
    border-color: #fca5a5;
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .sensory-delete-btn:focus-visible {
    outline-color: #fca5a5;
    box-shadow: 0 0 0 6px rgba(248, 113, 113, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .sensory-delete-btn,
    .sensory-delete-icon,
    .sensory-pulse-ring {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
