---
import RecoveryLayout from '../layouts/RecoveryLayout.astro';
import { getLocale, createTranslator } from '../i18n/index.js';
const t = createTranslator(getLocale(Astro));
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<RecoveryLayout documentTitleKey="recovery.resetDocumentTitle" title={t('recovery.resetTitle')} titleKey="recovery.resetTitle" description={t('recovery.resetDescription')} descriptionKey="recovery.resetDescription">
  <form method="post" action="/api/auth/restablecer" data-recovery data-reset>
    <input type="hidden" name="token" />
    <div class="field">
      <label for="reset-password" data-i18n="recovery.newPassword">{t('recovery.newPassword')}</label>
      <div class="input-wrap"><input id="reset-password" type="password" name="password" autocomplete="new-password" minlength="10" maxlength="128" required /></div>
    </div>
    <div class="field">
      <label for="reset-confirm" data-i18n="auth.confirm">{t('auth.confirm')}</label>
      <div class="input-wrap"><input id="reset-confirm" type="password" name="confirm" autocomplete="new-password" minlength="10" maxlength="128" required /></div>
    </div>
    <p class="status-message" role="status" data-recovery-status hidden></p>
    <button class="primary-button" type="submit" disabled data-i18n="recovery.save">{t('recovery.save')}</button>
    <p class="signup"><a class="text-button" href="/recuperar" data-i18n="recovery.requestAnother">{t('recovery.requestAnother')}</a></p>
  </form>
</RecoveryLayout>
