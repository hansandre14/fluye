---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/Brand.astro';
import { getLocale, createTranslator } from '../i18n/index.js';
const t = createTranslator(getLocale(Astro));
import { currentUser } from '../server/auth.js';
Astro.response.headers.set('Cache-Control', 'no-store');
const user = Astro.locals.user ?? await currentUser(Astro);
if (!user) return Astro.redirect('/');
---
<BaseLayout title={t('auth.verifiedTitle')} titleKey="auth.verifiedTitle">
  <main id="main-content" tabindex="-1" class="session-page"><section class="session-card" aria-labelledby="success-title">
    <Brand /><h1 id="success-title" data-i18n="auth.verifiedWelcome" data-i18n-params={JSON.stringify({ name: user.name })}>{t('auth.verifiedWelcome', { name: user.name })}</h1>
    <p data-i18n="auth.sessionEmail" data-i18n-params={JSON.stringify({ email: user.email })}>{t('auth.sessionEmail', { email: user.email })}</p>
    <p><a href="/dashboard" data-i18n="auth.goDashboard">{t('auth.goDashboard')}</a></p>
    <form action="/api/auth/logout" method="post"><button class="primary-button" type="submit" data-i18n="auth.logout">{t('auth.logout')}</button></form>
  </section></main>
</BaseLayout>
