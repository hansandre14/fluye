---
import FinanceLayout from '../layouts/FinanceLayout.astro';
import FinanceNotice from '../components/FinanceNotice.astro';
import MovementDialog from '../components/MovementDialog.astro';
import { currentUser } from '../server/auth.js';
import { privacyMode } from '../server/finance-http.js';
import { dashboardData } from '../server/movements.js';
import { accountFrom, dateLabel, soles } from '../lib/finance.js';
import { getLocale, createTranslator, categoryKey } from '../i18n/index.js';
const locale = getLocale(Astro);
const t = createTranslator(locale);

Astro.response.headers.set('Cache-Control', 'no-store');
const user = Astro.locals.user ?? await currentUser(Astro);
if (!user) return Astro.redirect('/');
const account = accountFrom(Astro.url.searchParams.get('cuenta'));
const isPro = account === 'profesional';
const hidden = privacyMode(Astro.cookies);
const data = await dashboardData(user.id, account);
const returnTo = '/registro?cuenta=' + account;

const quickTemplates = isPro
  ? [
      { kind: 'ingreso', concept: 'Honorarios profesionales', category: 'Honorarios', labelKey: 'registro.fees' },
      { kind: 'ingreso', concept: 'Venta a cliente', category: 'Ventas', labelKey: 'registro.sale' },
      { kind: 'gasto', concept: 'Suscripción de software', category: 'Servicios', labelKey: 'registro.software' },
      { kind: 'gasto', concept: 'Movilidad / Visita a cliente', category: 'Transporte', labelKey: 'registro.transport' },
      { kind: 'gasto', concept: 'Insumos de oficina', category: 'Compras', labelKey: 'registro.supplies' },
    ]
  : [
      { kind: 'gasto', concept: 'Almuerzo / Menú', category: 'Alimentación', labelKey: 'registro.lunch' },
      { kind: 'gasto', concept: 'Transporte / Pasaje', category: 'Transporte', labelKey: 'registro.travel' },
      { kind: 'gasto', concept: 'Compras del hogar', category: 'Alimentación', labelKey: 'registro.supermarket' },
      { kind: 'gasto', concept: 'Recibo de servicios', category: 'Servicios', labelKey: 'registro.services' },
      { kind: 'ingreso', concept: 'Sueldo / Quincena', category: 'Salario', labelKey: 'registro.salary' },
    ];
---
<FinanceLayout
  title={t('registro.title')} titleKey="registro.title"
  subtitle={t(isPro ? 'registro.subtitlePro' : 'registro.subtitlePersonal')} subtitleKey={isPro ? 'registro.subtitlePro' : 'registro.subtitlePersonal'}
  {user}
  {account}
  {hidden}
  page="/registro"
  {returnTo}
>
  <FinanceNotice code={Astro.url.searchParams.get('aviso')} {returnTo} />

  <section class="registro-status-strip" aria-label={t('registro.budgetStatus')} data-i18n-aria-label="registro.budgetStatus">
    <article class="finance-card registro-stat">
      <span data-i18n={isPro ? 'registro.availablePro' : 'registro.availablePersonal'}>{t(isPro ? 'registro.availablePro' : 'registro.availablePersonal')}</span>
      <strong>{soles(data.available, hidden)}</strong>
      <small data-i18n="registro.dailyLimit" data-i18n-params={JSON.stringify({amount: soles(data.limit, hidden)})}>{t('registro.dailyLimit', {amount: soles(data.limit, hidden)})}</small>
    </article>
    <article class="finance-card registro-stat">
      <span data-i18n="registro.spentToday" data-i18n-params={JSON.stringify({date: dateLabel(data.date)})}>{t('registro.spentToday', {date: dateLabel(data.date)})}</span>
      <strong>{soles(data.todaySpent, hidden)}</strong>
      <small data-i18n={data.todaySpent > data.limit ? 'registro.aboveLimit' : 'registro.withinLimit'}>{t(data.todaySpent > data.limit ? 'registro.aboveLimit' : 'registro.withinLimit')}</small>
    </article>
    <article class="finance-card registro-stat">
      <span data-i18n={isPro ? 'registro.businessResult' : 'registro.monthlyBalance'}>{t(isPro ? 'registro.businessResult' : 'registro.monthlyBalance')}</span>
      <strong class:list={[{ positive: (isPro ? (data.income - data.expenses) : data.balance) > 0 }]}>{soles(isPro ? (data.income - data.expenses) : data.balance, hidden)}</strong>
      <small data-i18n="registro.monthlySummary" data-i18n-params={JSON.stringify({income: soles(data.income, hidden), expenses: soles(data.expenses, hidden)})}>{t('registro.monthlySummary', {income: soles(data.income, hidden), expenses: soles(data.expenses, hidden)})}</small>
    </article>
  </section>

  <section class="finance-card registro-templates" aria-label={t('registro.quickTemplates')} data-i18n-aria-label="registro.quickTemplates">
    <div class="registro-templates-head">
      <strong data-i18n={isPro ? 'registro.templatesPro' : 'registro.templatesPersonal'}>{t(isPro ? 'registro.templatesPro' : 'registro.templatesPersonal')}</strong>
      <span data-i18n="registro.templatesHint">{t('registro.templatesHint')}</span>
    </div>
    <div class="registro-chips">
      {quickTemplates.map((tpl) => (
        <button
          type="button"
          class:list={['template-chip', { 'template-income': tpl.kind === 'ingreso' }]}
          data-quick-template
          data-tpl-kind={tpl.kind}
          data-tpl-concept={tpl.concept}
          data-tpl-category={tpl.category}
          data-i18n={tpl.labelKey}
        >
          {t(tpl.labelKey)}
        </button>
      ))}
    </div>
  </section>

  <div class="registro-workspace">
    <MovementDialog userId={user.id} {account} returnTo={'/dashboard?cuenta=' + account} standalone />
    <aside class="finance-card registro-recent" aria-label={t('registro.recentAccount')} data-i18n-aria-label="registro.recentAccount">
      <div class="card-heading">
        <h2 data-i18n="registro.recentTitle">{t('registro.recentTitle')}</h2>
        <a class="finance-link" href={'/movimientos?cuenta=' + account} data-i18n="registro.history">{t('registro.history')}</a>
      </div>
      {data.recent.length ? (
        <ul class="recent-list">
          {data.recent.slice(0, 5).map((row) => (
            <li>
              <span class="movement-initial" aria-hidden="true">{row.concept[0].toUpperCase()}</span>
              <span class="recent-concept">
                <strong>{row.concept}</strong>
                <small>{dateLabel(row.date)} · <span data-i18n={categoryKey(row.category)}>{t(categoryKey(row.category))}</span></small>
              </span>
              <strong class:list={['amount-text', { positive: row.kind === 'ingreso' }]}>
                {row.kind === 'ingreso' ? '+' : '−'} {soles(row.amount, hidden)}
              </strong>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-copy" data-i18n={isPro ? 'registro.emptyPro' : 'registro.emptyPersonal'}>{t(isPro ? 'registro.emptyPro' : 'registro.emptyPersonal')}</p>
      )}
    </aside>
  </div>
</FinanceLayout>
