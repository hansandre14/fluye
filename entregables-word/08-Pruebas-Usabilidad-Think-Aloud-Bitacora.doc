<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="utf-8">
<title>Actividad Práctica: Pruebas de Usabilidad Think-Aloud - Fluye</title>
<style>
  @page { size: A4; margin: 2.1cm; }
  body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; color: #1f2430; line-height: 1.5; font-size: 10.5pt; }
  h1 { color: #075e58; font-size: 16.5pt; border-bottom: 2px solid #0f766e; padding-bottom: 6px; margin-bottom: 12px; }
  h2 { color: #0f766e; font-size: 13pt; margin-top: 16px; margin-bottom: 8px; }
  .meta { background: #e5f1ed; padding: 11px 15px; border-left: 5px solid #0f766e; margin-bottom: 16px; font-size: 10pt; }
  table { width: 100%; border-collapse: collapse; margin: 10px 0 16px; font-size: 9.8pt; }
  th { background: #075e58; color: #ffffff; text-align: left; padding: 7px 9px; border: 1px solid #075e58; }
  td { padding: 7px 9px; border: 1px solid #cbd5e1; vertical-align: top; }
  tr:nth-child(even) td { background: #f8fafc; }
  .quote { font-style: italic; color: #0f172a; background: #f1f5f9; padding: 6px 10px; border-left: 3px solid #0f766e; margin: 4px 0; }
  .badge-ok { background: #dcfce7; color: #166534; font-weight: bold; padding: 2px 6px; }
</style>
